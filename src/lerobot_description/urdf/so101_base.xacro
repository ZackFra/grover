<?xml version="1.0"?>

<!--
  This file is based on the SO-ARM100 model from:
  https://github.com/TheRobotStudio/SO-ARM100
  and has been modified accordingly.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!--
	  Intel RealSense D405 macro (apt: ros-jazzy-realsense2-description). Defines
	  the `sensor_d405` xacro macro used below to attach the wrist camera frames.
	-->
	<xacro:include filename="$(find realsense2_description)/urdf/_d405.urdf.xacro" />

	<!-- Links -->
	<link name="world" />

	<joint name="base_joint" type="fixed">
		<parent link="world" />
		<child link="base" />
		<origin xyz="0 0 0" rpy="0 0 0" />
	</joint>

	<!-- Materials -->
	<material name="3d_printed">
		<color rgba="1.0 0.82 0.12 1.0" />
	</material>
	<material name="sts3215">
		<color rgba="0.1 0.1 0.1 1.0" />
	</material>

	<!--
	  Base link matches SO-ARM100 Simulation/SO101/so101_new_calib.urdf (Onshape export).
	  A mismatched base link frame vs shoulder_pan made the arm look twisted in RViz while
	  downstream link meshes already matched that reference.
	-->
	<link name="base">
		<inertial>
			<origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0" />
			<mass value="0.147" />
			<inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117"
				iyz="9.75275e-08" izz="0.000130364" />
		</inertial>
		<!-- Part base_motor_holder_so101_v1 -->
		<visual>
			<origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/base_motor_holder_so101_v1.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/base_motor_holder_so101_v1.stl" />
			</geometry>
		</collision>
		<!-- Part base_so101_v2 -->
		<visual>
			<origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/base_so101_v2.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/base_so101_v2.stl" />
			</geometry>
		</collision>
		<!-- Part sts3215_03a_v1 -->
		<visual>
			<origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
			<material name="sts3215" />
		</visual>
		<collision>
			<origin xyz="0.0263353 -8.97657e-09 0.0437" rpy="-8.21148e-16 7.84513e-18 1.249e-15" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
		</collision>
		<!-- Part waveshare_mounting_plate_so101_v2 -->
		<visual>
			<origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 -1.35493e-14 1.5708" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/waveshare_mounting_plate_so101_v2.stl" />
			</geometry>
		</collision>
	</link>

	<!-- Link shoulder -->
	<link name="shoulder">
		<inertial>
			<origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0" />
			<mass value="0.100006" />
