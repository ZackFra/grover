			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/motor_holder_so101_base_v1.stl" />
			</geometry>
		</collision>
		<!-- Part rotation_pitch_so101_v1 -->
		<visual>
			<origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 -0 0" />
