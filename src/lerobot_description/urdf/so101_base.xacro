					filename="package://lerobot_description/meshes/so101/motor_holder_so101_wrist_v1.stl" />
			</geometry>
		</collision>
		<!-- Part sts3215_03a_v1_4 -->
		<visual>
			<origin xyz="-0.1224 0.0052 0.0187" rpy="-3.14159 -3.58047e-15 -3.14159" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
