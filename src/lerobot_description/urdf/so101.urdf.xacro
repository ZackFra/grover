<?xml version="1.0"?>
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_sim" default="true"/>
    <xacro:arg name="usb_port" default="/dev/so101_follower"/>
    <!-- Hardware: state-only ros2_control joints → Feetech driver disables torque (see feetech_ros2_driver on_init). -->
    <xacro:arg name="hardware_passive" default="false"/>

    <xacro:include filename="$(find lerobot_description)/urdf/so101_base.xacro"/>

    <xacro:if value="${'$(arg use_sim)' in ('true', 'True', '1', 'yes')}">
        <xacro:include filename="$(find lerobot_description)/urdf/so101_gazebo.xacro"/>
    </xacro:if>

    <xacro:include filename="$(find lerobot_description)/urdf/so101_ros2_control.xacro"/>

</robot>
