	<!-- Link wrist -->
	<link name="wrist">
		<inertial>
			<origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0" />
			<mass value="0.079" />
			<inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05"
				iyz="3.6412e-06" izz="2.1e-05" />
		</inertial>
		<!-- Part sts3215_03a_no_horn_v1 -->
		<visual>
			<origin xyz="5.55112e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/sts3215_03a_no_horn_v1.stl" />
			</geometry>
			<material name="sts3215" />
		</visual>
		<collision>
			<origin xyz="5.55112e-17 -0.0424 0.0306" rpy="1.5708 1.5708 0" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/sts3215_03a_no_horn_v1.stl" />
			</geometry>
		</collision>
		<!-- Part wrist_roll_pitch_so101_v2 -->
		<visual>
			<origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/wrist_roll_pitch_so101_v2.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/wrist_roll_pitch_so101_v2.stl" />
			</geometry>
		</collision>
	</link>

	<!-- Link gripper -->
	<link name="gripper">
		<!--
		  Inertial composed via scripts/compute_link_inertia.py from:
		    Wrist_Roll_D405_Holder.stl @ 0.42 g/cm³ (PLA ~20% infill) → 27.31 g holder body,
		    plus an Intel RealSense D405 modeled as a 60 g uniform 42×42×23 mm box.
		  TODO(d405-offset): payload xyz is a PLACEHOLDER (0, -0.040, 0.020) m. After
		  RViz-verifying the holder mesh, measure the D405 body CoM offset on the
		  holder pocket and re-run compute_link_inertia.py (see its docstring for
		  the exact command). Wrong payload xyz mostly shows up as wrong off-diagonal
		  inertia and incorrect CoM along the wrist axis.
		-->
		<inertial>
			<origin xyz="-0.0037735 -0.0295254 0.00594451" rpy="0 0 0" />
			<mass value="0.087307" />
			<inertia ixx="9.89785e-05" ixy="9.62938e-06" ixz="-1.42765e-05" iyy="7.30242e-05"
				iyz="3.28486e-05" izz="6.1257e-05" />
		</inertial>
		<!-- Part sts3215_03a_v1_5 -->
		<visual>
			<origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.55112e-17 -1.38213e-14" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
			<material name="sts3215" />
		</visual>
		<collision>
			<origin xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.55112e-17 -1.38213e-14" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/sts3215_03a_v1.stl" />
			</geometry>
		</collision>
		<!-- Part Wrist_Roll_D405_Holder (replaces wrist_roll_follower_so101_v1; STL in mm → scale 1e-3). -->
		<visual>
			<origin xyz="5.55112e-17 -0.000218214 0.000949706"
				rpy="-3.14159 -5.55112e-17 -9.17912e-24" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/Wrist_Roll_D405_Holder.stl"
					scale="0.001 0.001 0.001" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="5.55112e-17 -0.000218214 0.000949706"
				rpy="-3.14159 -5.55112e-17 -9.17912e-24" />
			<geometry>
				<mesh
					filename="package://lerobot_description/meshes/so101/Wrist_Roll_D405_Holder.stl"
					scale="0.001 0.001 0.001" />
			</geometry>
		</collision>
	</link>

	<!-- Link jaw -->
	<link name="jaw">
		<inertial>
			<origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0" />
			<mass value="0.012" />
			<inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06"
				iyz="-1.09945e-07" izz="5.28738e-06" />
		</inertial>
		<!-- Part moving_jaw_so101_v1 -->
		<visual>
			<origin xyz="-5.55112e-17 -1.94746e-17 0.0189" rpy="9.53145e-17 -4.66093e-24 0" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/moving_jaw_so101_v1.stl" />
			</geometry>
			<material name="3d_printed" />
		</visual>
		<collision>
			<origin xyz="-5.55112e-17 -1.94746e-17 0.0189" rpy="9.53145e-17 -4.66093e-24 0" />
			<geometry>
				<mesh filename="package://lerobot_description/meshes/so101/moving_jaw_so101_v1.stl" />
			</geometry>
		</collision>
	</link>

	<!--
	  D405 wrist camera, mounted on the Wrist_Roll_D405_Holder.
	    parent=gripper          The fixed lower-jaw holder owns the camera.
	    name=d405_wrist         Frames are d405_wrist_link, d405_wrist_depth_optical_frame, …
	                            Match this with realsense2_camera's camera_name arg.
	    use_nominal_extrinsics  Publish nominal datasheet optical extrinsics from the URDF.
	                            With the live camera, launch realsense2_camera with
	                            publish_tf:=false so its calibrated frames don't fight.
	  TODO(d405-mount): replace xyz/rpy below with values measured on the printed
	  holder. The origin defines gripper → d405_wrist_bottom_screw_frame, where
	  bottom_screw_frame is the D405's tripod-mount point (bottom centerline of the
	  camera body) and +X points out the lens. Verify in RViz by toggling the
	  d405_wrist_link visual: it should sit on the holder's mount pad with the
	  lens facing the workspace.
	-->
	<xacro:sensor_d405 parent="gripper" name="d405_wrist" use_nominal_extrinsics="true">
		<origin xyz="0.000 -0.096 -0.020" rpy="0.0000 1.0472 1.5708" />
	</xacro:sensor_d405>

	<!-- Joint names align with Hugging Face LeRobot SO-101 (same as servo roles; gripper_joint avoids clashing with link 'gripper'). -->
	<!-- Joint from gripper link to jaw -->
	<joint name="gripper_joint" type="revolute">
		<origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.14108e-17 -1.38655e-14" />
		<parent link="gripper" />
		<child link="jaw" />
		<axis xyz="0 0 1" />
		<!-- Commanded full-close ≈ -0.1918 rad; limit slightly beyond for controller margin. -->
		<limit effort="10" velocity="10" lower="-0.22" upper="1.74533" />
	</joint>

	<!-- Joint from wrist to gripper link -->
	<joint name="wrist_roll" type="revolute">
		<origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159" />
		<parent link="wrist" />
		<child link="gripper" />
		<axis xyz="0 0 1" />
		<limit effort="10" velocity="10" lower="-2.79253" upper="2.79253" />
	</joint>

	<!-- Joint from lower_arm to wrist -->
	<joint name="wrist_flex" type="revolute">
		<origin xyz="-0.1349 0.0052 1.65232e-16" rpy="3.2474e-15 2.86219e-15 -1.5708" />
		<parent link="lower_arm" />
		<child link="wrist" />
		<axis xyz="0 0 1" />
		<!-- Widened from ±1.658 (±95°): leader teleop reaches past stock; avoids Servo limit spam. -->
		<limit effort="10" velocity="10" lower="-1.74533" upper="1.74533" />
	</joint>

	<!-- Joint from upper_arm to lower_arm -->
	<joint name="elbow_flex" type="revolute">
		<origin xyz="-0.11257 -0.028 2.46331e-16" rpy="-1.22818e-15 5.75928e-16 1.5708" />
		<parent link="upper_arm" />
		<child link="lower_arm" />
		<axis xyz="0 0 1" />
		<!-- Limits widened vs stock CAD: leader teleop uses ~−105° / ~+97° body postures after deg→rad -->
		<limit effort="10" velocity="10" lower="-1.74533" upper="1.85" />
	</joint>

	<!-- Joint from shoulder to upper_arm -->
	<joint name="shoulder_lift" type="revolute">
		<origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0" />
		<parent link="shoulder" />
		<child link="upper_arm" />
		<axis xyz="0 0 1" />
		<!-- Lower widened for HW teleop (home ≈ −1.75 rad; stock −2.05 left little “back” travel). -->
		<limit effort="10" velocity="10" lower="-2.35" upper="1.74533" />
	</joint>

	<!-- Joint from base to shoulder -->
	<joint name="shoulder_pan" type="revolute">
		<origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159" />
		<parent link="base" />
		<child link="shoulder" />
		<axis xyz="0 0 1" />
		<limit effort="10" velocity="10" lower="-1.91986" upper="1.91986" />
	</joint>
</robot>